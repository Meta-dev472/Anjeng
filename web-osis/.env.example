[TEMPLATE]
# Salin berkas ini menjadi .env lalu isi dengan domain asli situs.
# Memengaruhi: canonical, Open Graph, sitemap.xml, dan robots.txt.
VITE_SITE_URL=https://osis.smktexarkarawang.sch.id

# ---------------------------------------------------------------------------
# PANEL ADMIN — variabel di bawah ini diisi di DASHBOARD VERCEL
# (Project → Settings → Environment Variables), BUKAN di file .env.
# Function /api/admin hanya membaca env produksi Vercel.
# Lihat panduan lengkap di AGENTS.md §12.
# ---------------------------------------------------------------------------

# sha256 hex dari password admin. Generate:
#   node -e "console.log(require('crypto').createHash('sha256').update('PASSWORD_KAMU').digest('hex'))"
ADMIN_PASS_SHA256=

# String acak panjang (≥32 char) untuk menandatangani cookie sesi admin.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_KEY=

# Fine-grained personal access token GitHub: permission Contents → Read & write
# pada repo ini saja. Dipakai panel untuk commit perubahan konten.
GITHUB_TOKEN=

# "owner/repo" — isi manual (Vercel tidak menyediakannya otomatis).
GITHUB_REPO=

# Branch yang jadi target commit konten (default main).
GITHUB_BRANCH=main

# Path rahasia panel admin (huruf kecil, angka, tanda minus). Contoh:
#   ADMIN_PATH=portal-c41f8e
# Panel jadi /portal-c41f8e/ dan /admin/ menghilang dari produksi. Pilih
# kata wajar + angka acak (generate: node -e "console.log(require('crypto').randomBytes(4).toString('hex'))").
# JANGAN pakai kata yang ada di wordlist fuzzer: admin/panel/dashboard/cms/manage.
ADMIN_PATH=admin

# BLOB_READ_WRITE_TOKEN — TIDAK perlu diisi manual: dibuat otomatis oleh Vercel
# saat kamu membuat Blob store (tab Storage → Create Database/Blob → connect
# ke project ini). Dipakai function untuk menyimpan aspirasi.
